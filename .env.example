# Ollama Cloud API key. Create one at https://ollama.com/settings/keys
# Used only by the local proxy (`npm run proxy`). Never put this in the frontend.
OLLAMA_API_KEY=

# Optional. Port for the local proxy. Webpack dev server expects 8787 unless
# you also set OLLAMA_PROXY_TARGET in the environment before `npm start`.
# PORT=8787

# Optional. Browser-facing proxy origin, inlined at webpack build/dev-server start.
# Leave unset to use same-origin /ollama-proxy (dev server proxy, or Firebase Hosting rewrite).
# Example for calling Cloud Run directly (better token streaming):
# OLLAMA_PROXY_URL=https://ollama-proxy-XXXXX-uc.a.run.app

# Optional overrides for the proxy process:
# FIREBASE_PROJECT_ID=polyglot121725
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://polyglot121725.web.app,https://polyglot121725.firebaseapp.com
# RATE_LIMIT_PER_MIN=60
# PROXY_AUTH_REQUIRED=true
